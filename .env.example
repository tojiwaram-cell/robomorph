# ===== RoboMorph settings =====
# Free stock video keys (both free, sign up takes 1 minute):
#   Pexels : https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/   (key shown after login)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Facebook page (see README for how to get these)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v21.0

# Optional: Telegram notice after each post / failure
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Video length in seconds (Reels: 3-90)
VIDEO_SECONDS=30
# How many finished videos to keep ready in reserve
BUFFER_SIZE=4
# 1 = only log what would be posted (for testing)
DRY_RUN=0
# 1 = keep posted videos in posted/ instead of deleting
KEEP_POSTED=0
